<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nativedcb</AssemblyName>
    <RootNamespace>NativeDCB.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NativeDCB.Model\NativeDCB.Model.csproj" />
    <ProjectReference Include="..\NativeDCB.Protocol\NativeDCB.Protocol.csproj" />
    <ProjectReference Include="..\NativeDCB.Sdk\NativeDCB.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
  </ItemGroup>

</Project>
