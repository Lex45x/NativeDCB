{
  "MaxEventCountPerPartition": 10000,
  "Orleans": {
    "SiloPort": 11111,
    "GatewayPort": 30000
  },
  "GrpcWeb": {
    "AllowedOrigins": [
      "http://localhost:5094",
      "https://localhost:7229"
    ]
  },
  "Authentication": {
    "Providers": "ApiKey",
    "ApiKeys": {
      "StorePath": ".security/api_keys_v1.json",
      "BootstrapOnEmptyStore": true
    }
  },
  "Audit": {
    "MaxRecordCountPerPartition": 10000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
