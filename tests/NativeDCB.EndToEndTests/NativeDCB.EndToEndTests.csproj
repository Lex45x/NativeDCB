<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NativeDCB.Model\NativeDCB.Model.csproj" />
    <ProjectReference Include="..\..\src\NativeDCB.Ndl\NativeDCB.Ndl.csproj" />
    <ProjectReference Include="..\..\src\NativeDCB.Protocol\NativeDCB.Protocol.csproj" />
    <ProjectReference Include="..\..\src\NativeDCB.Server\NativeDCB.Server.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NativeDCB.Sdk\NativeDCB.Sdk.csproj" />
    <ProjectReference Include="..\..\samples\CourseSubscriptions\CourseSubscriptions.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="CopyNativeDcbServer" AfterTargets="Build">
    <ItemGroup>
      <NativeDcbServerOutput Include="..\..\src\NativeDCB.Server\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <CourseSubscriptionsOutput Include="..\..\samples\CourseSubscriptions\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDcbServerOutput)"
          DestinationFiles="@(NativeDcbServerOutput->'$(OutDir)server\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CourseSubscriptionsOutput)"
          DestinationFiles="@(CourseSubscriptionsOutput->'$(OutDir)sample\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
